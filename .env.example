# Copy to `.env` for local development. Never commit `.env`.

# Alipay Open Platform (sandbox) — S5
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SANDBOX_PAYEE=

# Optional: override data directory (default ~/.qingfu-envoy)
QINGFU_DATA_DIR=

# Optional: principal id for CLI approve/execute audit actor
QINGFU_PRINCIPAL_ID=local-principal

# Optional: PaymentRail for CLI/Web — mock (default) | alipay
# alipay requires ALIPAY_* above; missing credentials error out (no mock fallback)
QINGFU_RAIL=mock

# Optional: gate MCP principal actions on local machine
QINGFU_PRINCIPAL_TOKEN=
